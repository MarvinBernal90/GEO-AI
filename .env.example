# Copia este fichero como ".env" en la raíz del repo y rellena los valores.
# Usado tanto para ejecución local (python -m backend.api.main) como por
# docker-compose (deployment/docker-compose.yml apunta a este mismo fichero
# vía "env_file: ../.env", para no duplicar variables en dos sitios).

# --- Base de datos (Postgres/PostGIS + pgvector) ---
POSTGRES_DB=geoyield
POSTGRES_USER=geoyield_user

POSTGRES_PASSWORD=changeme

# Cuando se ejecuta vía docker-compose, el host debe ser el nombre del
# servicio definido en docker-compose.yml ("postgis"), no "localhost", ya
# que la resolución de nombres ocurre dentro de la red interna de Docker.
# Para ejecución local sin Docker, cambia "postgis" por "localhost".
DATABASE_URL=postgresql+psycopg2://geoyield_user:changeme@postgis:5432/geoyield

# --- Logging ---
# 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR (niveles estándar del módulo logging)
LOG_LEVEL=20

# --- Entorno ---
# "development" habilita el autoreload de uvicorn; cualquier otro valor lo desactiva.
ENV=development

# --- Fase 2 (motor RAG legal) ---
# Necesaria para la generación de respuestas (backend/rag/query_engine.py).
# Los embeddings son locales (sentence-transformers), no necesitan API key.
#ANTHROPIC_API_KEY=

# Opcional: modelo de generación a usar (por defecto claude-sonnet-5 si se deja vacío)
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: alternativa gratuita de pruebas mientras no haya presupuesto
# para Anthropic (ver backend/rag/gemini_adapter.py). Cuota gratuita
# limitada a 20 peticiones/día. No es la decisión final de proveedor.

####### API KEYS #######
# Ahora mismo se usanlas de gemini y HF. Solamente necesarias si no se usan los modelos AWS Berock, que es la opción por defecto actual
#GEMINI_API_KEY=
#HF_TOKEN=

# Modelo para generación de texto y razonamiento de respuestas en el agente ReAct. Se puede cambiar por otro modelo de la familia Gemini si se quiere.
#GENERATION_MODEL = 'models/gemini-3.6-flash'

#se usa este modelo por ser de la misma familia que el que se usa para el bi-encoder (sentence-transformers/all-MiniLM-L6-v2) 
# sería apropiado ponerlo aquí como variable de entorno para poder cambiarlo fácilmente si se quiere usar otro modelo
# también el númeoro de dimensiones del embedding debe coincidir con el del modelo de embeddings (384 para all-MiniLM-L6-v2)
#RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# parametirzación del resumen en el chat: quando el número de mensajes en la conversación supera MAX_NUM_MESSAGES, se resumen 
# los últimos NUM_MESSGES_TO_SUMMARIZE mensajes para no perder contexto y no superar el límite de tokens del modelo de generación.
MAX_NUM_MESSAGES = 4
NUM_MESSAGES_TO_SUMMARIZE = 3

# Comentar DB_HOST_OVERRIDE si no se está en modo desarrollo (por ejemplo, en producción con docker-compose) para que la app use el host del contenedor de la base de datos (postgis) en lugar de localhost.
DB_HOST_OVERRIDE=localhost

# --- Frontend ---
# Base URL for the Backend API.
# Security Note: Vite will only expose variables to the browser if they
# are explicitly prefixed with "VITE_".
# In local development (running Uvicorn standalone), it points to localhost:8000.
# If left undefined, the frontend defaults to this value.
# Note: docker-compose publishes the API on host port 8080, not 8000 -- change this value accordingly when running the backend via docker
VITE_API_BASE_URL=http://localhost:8000

# CORS_ORIGINS is a comma-separated list of origins that are allowed to make cross-origin requests to the backend API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173



# --- 4. RAG Engine and AI Foundation Models (Amazon Bedrock) ---
# Primary production stack on AWS Bedrock:
# - Embeddings: Amazon Titan Text Embeddings V2 (1024 dimensions)
# - Rerank: Amazon Rerank 1.0 (or Cohere Rerank 3.5)
# - Generation: Amazon Nova Lite (or Amazon Nova Micro)
# Authentication uses IAM instance profiles / AWS credentials in AWS_PROFILE / environment.
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSION=1024
RERANK_MODEL=amazon.rerank-v1:0
GENERATION_MODEL=arn:aws:bedrock:eu-central-1:192445490421:inference-profile/eu.amazon.nova-2-lite-v1:0
# BEDROCK_MODEL=amazon.nova-lite-v1:0
# AWS_RERANK_REGION=eu-central-1


# Optional / Fallback Provider (Google Gemini):
# Set LLM_PROVIDER=gemini if using Google AI Studio API keys instead of Bedrock.
# LLM_PROVIDER=bedrock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# AWS credentials, needed for local development and for the RAG legal engine (to access S3 bucket with legal documents). 
# If an SSO session with profile AWS_PROFILE is in place, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN are not needed, as boto3 will use the SSO session automatically. In production, these are provided by the AWS IAM role attached to the EC2 instance or ECS task.
# In production, these are provided by the AWS IAM role attached to the EC2 instance or ECS task.
AWS_PROFILE=AdministratorAccess-192445490421
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1  