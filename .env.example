# Copia este fichero como ".env" en la raíz del repo y rellena los valores.
# Usado tanto para ejecución local (python -m backend.api.main) como por
# docker-compose (deployment/docker-compose.yml apunta a este mismo fichero
# vía "env_file: ../.env", para no duplicar variables en dos sitios).

# --- Base de datos (Postgres/PostGIS + pgvector) ---
POSTGRES_DB=geoyield
POSTGRES_USER=geoyield_user
POSTGRES_PASSWORD=changeme

# Cuando se ejecuta vía docker-compose, el host debe ser el nombre del
# servicio definido en docker-compose.yml ("postgis"), no "localhost", ya
# que la resolución de nombres ocurre dentro de la red interna de Docker.
# Para ejecución local sin Docker, cambia "postgis" por "localhost".
DATABASE_URL=postgresql+psycopg2://geoyield_user:changeme@postgis:5432/geoyield

# --- Logging ---
# 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR (niveles estándar del módulo logging)
LOG_LEVEL=20

# --- Entorno ---
# "development" habilita el autoreload de uvicorn; cualquier otro valor lo desactiva.
ENV=development

# --- Fase 2 (motor RAG legal) ---
# Necesaria para la generación de respuestas (backend/rag/query_engine.py).
# Los embeddings son locales (sentence-transformers), no necesitan API key.
ANTHROPIC_API_KEY=

# Opcional: modelo de generación a usar (por defecto claude-sonnet-5 si se deja vacío)
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: alternativa gratuita de pruebas mientras no haya presupuesto
# para Anthropic (ver backend/rag/gemini_adapter.py). Cuota gratuita
# limitada a 20 peticiones/día. No es la decisión final de proveedor.
# GEMINI_API_KEY=
